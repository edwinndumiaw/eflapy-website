---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on the Eflapy Digital website." noindex>
  <section class="hero" aria-labelledby="page-heading">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1 id="page-heading">This page does not exist.</h1>
      <p class="lead">The link may be old, or the address may have a typo. Here are some places to start.</p>
      <div class="btn-row">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn--ghost" href="/services/">See our services</a>
        <a class="btn btn--ghost" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
