---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts, formatDate, type Post } from '../../lib/posts';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: post.data.title, href: `/blog/${post.id}/` },
];
const iso = post.data.date.toISOString();
---
<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={iso}
  breadcrumbs={crumbs}
  schema={[{
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: iso,
    dateModified: iso,
    author: post.data.author === SITE.name
      ? { '@id': `${SITE.url}/#organization` }
      : { '@type': 'Person', name: post.data.author },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: url,
    url,
    image: `${SITE.url}${SITE.ogImage}`,
    keywords: post.data.tags.join(', '),
  }]}
>
  <article>
    <header class="page-hero">
      <div class="container narrow">
        <Breadcrumbs items={crumbs} />
        <h1 id="page-heading">{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <div class="post-meta">
          <span>{post.data.author}</span>
          <time datetime={iso}>{formatDate(post.data.date)}</time>
        </div>
      </div>
    </header>
    <div class="section">
      <div class="container narrow prose">
        <Content />
        {post.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
        )}
        <p class="mt-l"><a class="text-link" href="/blog/">Back to all posts</a></p>
      </div>
    </div>
  </article>
  <CTA />
</Base>
