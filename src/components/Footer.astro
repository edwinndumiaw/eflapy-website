---
import { NAV, SITE, BOOKING_URL } from '../config';
const extra = [
  { label: 'Newsroom', href: '/newsroom/' },
  { label: 'Book a review', href: '/book/' },
  { label: 'RSS', href: '/rss.xml' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <p class="footer-tagline">{SITE.tagline}</p>
      <a class="btn btn--light" href={BOOKING_URL}>Book an operations review</a>
    </div>
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="Eflapy Digital home"><img src="/logo-dark-360.png" alt="Eflapy Digital" width="150" height="59" loading="lazy" /></a>
        <p>Eflapy Digital is an AI operations firm based in Nairobi, Kenya. {SITE.process}</p>
      </div>
      <nav aria-label="Footer">
        <h2 class="footer-h">Pages</h2>
        <ul>
          {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          {extra.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="footer-h">Contact</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
          <li>{SITE.city}, {SITE.country}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Eflapy Digital. All rights reserved.</p>
      <p>{SITE.tagline}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-inverse-bg); color: var(--color-inverse-text); padding: 88px 0 40px; }
  .footer-top { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-bottom: 56px; border-bottom: 1px solid var(--color-inverse-rule); }
  .footer-tagline { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.1; margin: 0; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 48px; padding: 56px 0; }
  .footer-brand img { width: 150px; margin-bottom: 20px; }
  .footer-brand p { color: var(--color-inverse-muted); max-width: 340px; margin: 0; }
  .footer-h { font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-inverse-muted); margin-bottom: 18px; }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer li { margin-bottom: 10px; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--color-inverse-rule); padding-top: 28px; color: var(--color-inverse-muted); font-size: 0.9rem; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
